      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Devuelve el id', () => pm.expect(pm.response.json().id).to.eql('emi-100'));"
            ]
          }
        }
      ]
    },
